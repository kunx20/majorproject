APP_NAME=Clinical Guideline QA System
APP_VERSION=0.1.0
DEBUG=True
API_KEY=your_api_key_here

# Ollama Configuration
# Make sure Ollama is running locally before starting the app
# Download from: https://ollama.ai
# Available models: mistral, llama2, neural-chat, dolphin-mixtral, etc.
OLLAMA_MODEL=neural-chat
OLLAMA_BASE_URL=http://localhost:11434
USE_LLM=true

# GPU Acceleration Settings (for faster inference)
# Set to 'true' if you have NVIDIA/AMD/Intel GPU available
ENABLE_GPU=true
# Number of layers to offload to GPU (higher = more GPU usage, faster)
# Typical values: 20-40 layers. Increase if you have sufficient VRAM
NUM_GPU_LAYERS=20
# CPU threads for parallel processing (match your CPU cores for best performance)
NUM_THREADS=4

